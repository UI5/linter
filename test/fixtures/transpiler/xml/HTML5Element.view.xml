<mvc:View xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.html"
    xmlns:m="sap.m"
>
  <!-- Simple scenario -->
  <div>
    <m:Button text="Press Me!"/>
  </div>

  <!-- Scenario with children aggregation -->
  <div>
    <m:Button text="Press Me!"/>
    <children>
      <p>Hello me</p>
    </children>
  </div>

  <!-- Scenario with sap/ui/core/Control borrowed aggregation -->
  <div>
    <m:Button text="Press Me!"/>
    <dependents>
      <m:Text text="Hello me"/>
    </dependents>
  </div>

  <!-- Scenario with custom data property -->
  <div>
    <span data-foo-bar="My Bar">Hello me</span>
  </div>

  <!-- Scenario with text content -->
  <div>
    Hello world!
    <m:Button text="Press Me!"/>
    How are you?
    <children>
      How are you?
    </children>
  </div>

  <!-- Scenario with attributes -->
  <div style="color:red;" />
  <label for="input"/>
  <input id="input" type="tel" />

</mvc:View>
